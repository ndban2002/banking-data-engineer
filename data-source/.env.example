# Copy to .env and replace placeholders. The CLI does not load this file automatically.
# Run from data-source/: set -a; source .env; set +a
SSH_HOST=your-server.example.com
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY_PATH="$HOME/.ssh/id_ed25519"
SSH_LOCAL_PORT=15432
PG_REMOTE_HOST=127.0.0.1
PG_REMOTE_PORT=5432

# Connect to the local tunnel endpoint; PostgreSQL credentials are separate from SSH.
DATABASE_URL='postgresql://sim_user:your_password@127.0.0.1:15432/banking_lab'
