ARG SPARK_VERSION=3.5.6
FROM apache/spark:${SPARK_VERSION}-python3

ARG ICEBERG_VERSION=1.9.2
ARG POSTGRES_JDBC_VERSION=42.7.5

USER root
RUN apt-get update && apt-get install -y --no-install-recommends gettext-base curl && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /opt/spark/jars && \
    curl -fL "https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-3.5_2.12/${ICEBERG_VERSION}/iceberg-spark-runtime-3.5_2.12-${ICEBERG_VERSION}.jar" \
      -o "/opt/spark/jars/iceberg-spark-runtime-3.5_2.12-${ICEBERG_VERSION}.jar" && \
    curl -fL "https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-aws-bundle/${ICEBERG_VERSION}/iceberg-aws-bundle-${ICEBERG_VERSION}.jar" \
      -o "/opt/spark/jars/iceberg-aws-bundle-${ICEBERG_VERSION}.jar" && \
    curl -fL "https://repo1.maven.org/maven2/org/postgresql/postgresql/${POSTGRES_JDBC_VERSION}/postgresql-${POSTGRES_JDBC_VERSION}.jar" \
      -o "/opt/spark/jars/postgresql-${POSTGRES_JDBC_VERSION}.jar"

COPY spark-defaults.conf.template /opt/spark/conf/spark-defaults.conf.template
USER 185
