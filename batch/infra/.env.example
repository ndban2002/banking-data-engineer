# Local development only. Override these values before exposing services beyond localhost.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ICEBERG_REST_PORT=8181
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
SPARK_SQL_PORT=10000
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# PostgreSQL source; for a host SSH tunnel on macOS/Windows use host.docker.internal.
SOURCE_PG_HOST=host.docker.internal
SOURCE_PG_PORT=15432
SOURCE_PG_DATABASE=bank
SOURCE_PG_SCHEMA=core_sim
SOURCE_PG_USER=replace_me
SOURCE_PG_PASSWORD=replace_me
